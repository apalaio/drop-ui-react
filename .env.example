# Copy this file to .env (git-ignored) and fill in the key. The server starts without it and
# answers 503 to POST /api/generate-ui until it is set.
ANTHROPIC_API_KEY=

# Optional. The model that turns a description into elements.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional. The port of the Express server, which the Vite dev server proxies /api to.
# API_PORT=3001
